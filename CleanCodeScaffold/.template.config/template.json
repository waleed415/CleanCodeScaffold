{
  "$schema": "http://json.schemastore.org/template",
  "author": "Waleed Ur Rehaman",
  "classifications": ["Web", "Api"],
  "name": "CleanCodeScaffold",
  "identity": "Clean.Code.Scaffold.Template",
  "shortName": "CCScaffold",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanCodeScaffold",
  "preferNameDirectory": true,
  "logo":"logo.png",
  "symbols": {
    "httpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
          "low": 5000,
          "high": 6000
      },
      "replaces": "{httpPort}"
    },
    "httpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 6001,
        "high": 7000
      },
      "replaces": "{httpsPort}"
    },
    "connectionString": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Connection String",
      "description": "Enter the connection string for your database:",
      "defaultValue": "Data Source=local;Initial Catalog=CleanCodeDB;Integrated Security=True;TrustServerCertificate=True",
      "isRequired": true,
      "replaces": "{connectionString}"
    },
    "databaseProvider": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Database Provider",
      "choices": [
        {
          "choice": "MS SQL Server"
        },
        {
          "choice": "PostgreSQL"
        }
      ],
      "defaultValue": "MS SQL Server",
      "replaces": "{databaseProvider}"
    },
    "framework":{
      "type": "parameter",
      "displayName": "Target Framework",
      "datatype":"choice",
      "choices": [
        {
        "choice": "net6.0"
      },
      {
        "choice": "net8.0"
      },
      {
        "choice": "net10.0"
      }
    ],
    "defaultValue": "net8.0",
    "replaces": "{TargetFramework}"
    },
    "efCoreVersion": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(framework == \"net6.0\")",
            "value": "6.0.36"
          },
          {
            "condition": "(framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(framework == \"net10.0\")",
            "value": "10.0.9"
          }
        ]
      },
      "replaces": "{efVersion}"
    },
    "swashbuckleVersion": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(framework == \"net6.0\")",
            "value": "6.2.3"
          },
          {
            "condition": "(framework == \"net8.0\")",
            "value": "6.4.0"
          },
          {
            "condition": "(framework == \"net10.0\")",
            "value": "6.5.0"
          }
        ]
      },
      "replaces": "{SwashbuckleVersion}"
    },
      "efToolVersion": {
        "type": "generated",
        "generator": "switch",
        "parameters": {
          "evaluator": "C++",
          "cases": [
            {
              "condition": "(framework == \"net6.0\")",
              "value": "6.0.36"
            },
            {
              "condition": "(framework == \"net8.0\")",
              "value": "8.0.25"
            },
            {
              "condition": "(framework == \"net10.0\")",
              "value": "10.0.9"
            }
          ]
        },
        "replaces": "{efToolVersion}"
      },
      "autoMapperVersion": {
        "type": "generated",
        "generator": "switch",
        "parameters": {
          "evaluator": "C++",
          "cases": [
            {
              "condition": "(framework == \"net6.0\")",
              "value": "12.0.1"
            },
            {
              "condition": "(framework == \"net8.0\")",
              "value": "13.0.1"
            },
            {
              "condition": "(framework == \"net10.0\")",
              "value": "16.1.1"
            }
