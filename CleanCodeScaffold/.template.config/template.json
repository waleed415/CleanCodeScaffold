            },
            {
              "condition": "(framework == \"net8.0\")",
              "value": "8.0.28"
            },
            {
              "condition": "(framework == \"net10.0\")",
              "value": "10.0.9"
            }
          ]
        },
        "replaces": "{jwtBearerVersion}"
      },
      "PostgreSQLVersion": {
        "type": "generated",
        "generator": "switch",
        "parameters": {
          "evaluator": "C++",
          "cases": [
            {
              "condition": "(framework == \"net6.0\")",
              "value": "6.0.22"
            },
            {
              "condition": "(framework == \"net8.0\")",
              "value": "8.0.11"
            },
            {
