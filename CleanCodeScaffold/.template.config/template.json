      "SerilogMSSqlServerVersion": {
        "type": "generated",
        "generator": "switch",
        "parameters": {
          "evaluator": "C++",
          "cases": [
            {
              "condition": "(framework == \"net6.0\")",
              "value": "6.1.3"
            },
            {
              "condition": "(framework == \"net8.0\")",
