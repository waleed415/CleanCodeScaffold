{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/${workspaceFolderBasename}.Api/bin/Debug/${input:targetFramework}/${workspaceFolderBasename}.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/${workspaceFolderBasename}.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ],
     "inputs": [
        {
            "id": "targetFramework",
            "type": "pickString",
            "description": "Select the target framework for this run:",
            "options": ["net6.0", "net8.0", "net10.0"],
            "default": "net10.0"
        }
    ]
}
